@page
@model IndexModel
@{
    ViewData["Title"] = "Sonwabile Langa | Independent web developer";
    ViewData["Description"] = "Thoughtful websites and web apps, designed and built by Sonwabile Langa in Mossel Bay, South Africa.";
}

<section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Independent developer <span class="eyebrow-divider">/</span> Mossel Bay, South Africa</p>
        <h1 id="hero-title">A little more <span>you.</span><br />A lot more <span>online.</span></h1>
        <p class="hero-intro">I’m Sonwabile Langa. I design and build thoughtful websites and web apps that help ambitious businesses move forward.</p>
        <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
            <a class="button button-secondary" href="https://wa.me/27735630190?text=Hi%20Sonwabile%20%E2%80%94%20I%20saw%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project." target="_blank" rel="noreferrer">Start a conversation <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="service-ribbon" aria-label="Services">
            <li>Strategy</li>
            <li>Design</li>
            <li>Development</li>
        </ul>
    </div>
    <div class="hero-art" aria-label="Independent web studio illustration">
        <div class="art-orbit orbit-one"></div>
        <div class="art-orbit orbit-two"></div>
        <div class="hero-art-top"><span>SL / DIGITAL</span><span>EST. MOSSEL BAY</span></div>
        <div class="hero-monogram">SL<span>.</span></div>
        <div class="art-card art-card-back"><span class="art-card-label">YOUR NEXT BIG THING</span><span class="art-card-lines"></span><span class="art-card-lines short"></span></div>
        <div class="art-card art-card-front"><span class="mini-window"><i></i><i></i><i></i></span><span class="art-spark">✳</span><span class="art-card-caption">Made with<br />intention.</span></div>
        <div class="hero-art-bottom"><span>PERSONAL ATTENTION</span><span>END-TO-END DELIVERY ↗</span></div>
    </div>
    <a class="scroll-cue" href="#work">Scroll to explore <span aria-hidden="true">↓</span></a>
</section>

<section class="section work-section" id="work" aria-labelledby="work-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow section-kicker">01 / Selected work</p>
            <h2 id="work-title">Work that <span>works.</span></h2>
        </div>
        <p class="section-note">A varied collection of digital experiences, made for real businesses and real people.</p>
    </div>
    <div class="project-filters" role="group" aria-label="Filter projects">
        <button class="filter-chip is-active" type="button" data-filter="all" aria-pressed="true">All <span>@Model.Projects.Count.ToString("00")</span></button>
        @foreach (var category in Model.ProjectCategories)
        {
            <button class="filter-chip" type="button" data-filter="@category" aria-pressed="false">@category</button>
        }
    </div>
    <div class="project-grid" id="project-grid">
        @foreach (var project in Model.Projects)
        {
            <article class="project-card" data-category="@project.Category">
                <a class="project-art @project.ArtClass" href="#contact" aria-label="Discuss a project like @project.Name">
                    <span class="project-index">@project.Number / 15</span>
                    <span class="project-art-label">@project.Category</span>
                    <span class="project-art-window" aria-hidden="true">
                        <span class="window-top"><i></i><i></i><i></i><b>@project.ArtTitle</b></span>
                        <span class="window-content">
                            <span class="window-heading">@project.ArtHeading</span>
                            <span class="window-line"></span>
                            <span class="window-line window-line-short"></span>
                            <span class="window-shape">@project.ArtMark</span>
                        </span>
                    </span>
                    <span class="project-art-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="project-meta">
                    <div><p class="project-category">@project.Category</p><h3>@project.Name</h3></div>
                    <span class="project-link-mark" aria-hidden="true">↗</span>
                </div>
                <p class="project-description">@project.Description</p>
            </article>
        }
    </div>
</section>

<section class="about-section section" id="about" aria-labelledby="about-title">
    <div class="about-copy">
        <p class="eyebrow section-kicker">02 / A little about me</p>
        <h2 id="about-title">Small studio energy.<br /><span>One-on-one attention.</span></h2>
        <p>I’m Sonwabile, a full-stack developer based in Mossel Bay, South Africa. I partner directly with people building businesses, services, and ideas worth bringing online.</p>
        <p>From the first conversation to launch, you work with me—not a hand-off chain. I bring design and development together to make useful, considered digital experiences for the Garden Route and beyond.</p>
        <a class="text-link" href="#contact">Tell me what you’re building <span aria-hidden="true">↗</span></a>
    </div>
    <div class="service-cards">
        <article class="service-card"><span class="service-number">01</span><div><h3>Business websites</h3><p>Sharp, fast sites for local brands — trades, hospitality, beauty studios, retail, and startups.</p></div><span class="service-symbol" aria-hidden="true">↗</span></article>
        <article class="service-card"><span class="service-number">02</span><div><h3>Web apps &amp; portals</h3><p>Directories, dashboards, booking flows, and product experiences that people actually use.</p></div><span class="service-symbol" aria-hidden="true">⌘</span></article>
        <article class="service-card"><span class="service-number">03</span><div><h3>Full-stack delivery</h3><p>From design to deployment — one accountable partner who owns build, launch, and care.</p></div><span class="service-symbol" aria-hidden="true">✳</span></article>
    </div>
</section>

<section class="stack-section section" id="stack" aria-labelledby="stack-title">
    <div class="section-heading">
        <div><p class="eyebrow section-kicker">03 / The toolkit</p><h2 id="stack-title">The right tools<br /><span>for the job.</span></h2></div>
        <p class="section-note">A complete toolkit for shaping, building, and launching dependable digital products.</p>
    </div>
    <div class="stack-grid">
        <article class="stack-card"><span class="stack-index">01</span><h3>Frontend</h3><p>React · Next.js · TypeScript · JavaScript · HTML5 · CSS3 · Tailwind CSS</p></article>
        <article class="stack-card"><span class="stack-index">02</span><h3>Backend</h3><p>Node.js · Express · Python · Django · Flask · PHP · REST APIs</p></article>
        <article class="stack-card"><span class="stack-index">03</span><h3>Data</h3><p>PostgreSQL · MySQL · MongoDB · Firebase · SQLite</p></article>
        <article class="stack-card"><span class="stack-index">04</span><h3>CMS &amp; design</h3><p>WordPress · Figma · Git · GitHub</p></article>
        <article class="stack-card"><span class="stack-index">05</span><h3>Ship &amp; host</h3><p>Vercel · Netlify · AWS · Docker · CI/CD</p></article>
    </div>
</section>

<section class="contact-section section" id="contact" aria-labelledby="contact-title">
    <div class="contact-intro">
        <p class="eyebrow section-kicker">04 / The next move is yours</p>
        <h2 id="contact-title">Let’s build<br /><span>something meaningful.</span></h2>
        <p>Have a project, a question, or just an idea you want to explore? I’d love to hear about it.</p>
        <div class="contact-details">
            <a href="mailto:langasonwabile1993@gmail.com"><span class="contact-icon" aria-hidden="true">✉</span><span><small>Email</small>langasonwabile1993@gmail.com</span></a>
            <a href="tel:+27735630190"><span class="contact-icon" aria-hidden="true">↗</span><span><small>Call</small>073 563 0190</span></a>
            <p><span class="contact-icon" aria-hidden="true">⌖</span><span><small>Based in</small>Mossel Bay, South Africa</span></p>
        </div>
        <a class="whatsapp-link" href="https://wa.me/27735630190?text=Hi%20Sonwabile%20%E2%80%94%20I%20saw%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project." target="_blank" rel="noreferrer">Message me on WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
    <form class="contact-form" id="contact-form" method="post" asp-page-handler="Send">
        <p class="form-eyebrow">A good project starts with a hello.</p>
        <div class="form-row">
            <label>First name<input asp-for="FirstName" autocomplete="given-name" placeholder="Your first name" required /><span asp-validation-for="FirstName"></span></label>
            <label>Last name<input asp-for="LastName" autocomplete="family-name" placeholder="Your last name" required /><span asp-validation-for="LastName"></span></label>
        </div>
        <label>Email address<input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" required /><span asp-validation-for="Email"></span></label>
        <label>What are you looking to build?<select asp-for="Project" required><option value="" disabled>Choose a project type</option><option>Business website</option><option>Web app or portal</option><option>E-commerce experience</option><option>Something else</option></select><span asp-validation-for="Project"></span></label>
        <label>A little more about it<textarea asp-for="Message" rows="4" placeholder="Tell me about your idea..." required></textarea><span asp-validation-for="Message"></span></label>
        <button class="button button-primary form-submit" type="submit">Send message <span aria-hidden="true">↗</span></button>
        @if (Model.ContactStatus is not null)
        {
            <p class="form-note @(Model.ContactSent ? "form-note-success" : "form-note-error")" id="form-note" role="status" aria-live="polite">@Model.ContactStatus</p>
        }
        else
        {
            <p class="form-note" id="form-note">Your message will be sent securely by email.</p>
        }
    </form>
</section>

<footer class="site-footer">
    <a class="footer-brand" href="#top"><span class="brand-mark">SL<span>.</span></span><span>Sonwabile Langa<small>Independent full-stack development</small></span></a>
    <p>Thoughtful digital experiences.<br />Mossel Bay, South Africa.</p>
    <div class="footer-links"><a href="#work">Work</a><a href="#about">About</a><a href="#stack">Stack</a><a href="#contact">Contact</a></div>
    <span class="footer-copy">© @DateTime.Now.Year Sonwabile Langa</span>
</footer>
