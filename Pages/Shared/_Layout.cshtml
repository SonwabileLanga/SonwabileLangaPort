<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Independent web development from Mossel Bay, South Africa.")" />
    <meta name="theme-color" content="#11120f" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root{color-scheme:dark;--ink:#11120f;--paper:#f3f0e9;--muted:#a4a49a;--line:rgba(243,240,233,.14);--accent:#c9f36a;--display:"Manrope",Arial,sans-serif;--body:"DM Sans",Arial,sans-serif;--mono:"DM Mono",monospace}
        *{box-sizing:border-box}
        html{scroll-behavior:smooth;scroll-padding-top:100px}
        body{margin:0;background:var(--ink);color:var(--paper);font:16px var(--body);-webkit-font-smoothing:antialiased}
        body:before{position:fixed;z-index:-1;inset:0;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:84px 84px;content:"";pointer-events:none}
        a{color:inherit;text-decoration:none}
        .site-header{position:sticky;top:16px;z-index:20;display:flex;width:min(1440px,calc(100% - 64px));min-height:76px;margin:16px auto 0;padding:10px 14px 10px 12px;align-items:center;justify-content:space-between;border:1px solid rgba(243,240,233,.13);border-radius:18px;background:rgba(17,18,15,.94);backdrop-filter:blur(18px)}
        .header-brand,.footer-brand{display:flex;gap:12px;align-items:center}
        .brand-mark{display:grid;width:46px;height:46px;flex:0 0 auto;place-items:center;border-radius:13px;background:var(--accent);color:var(--ink);font:800 16px var(--display);letter-spacing:-.08em}
        .brand-mark span{color:#647d27}
        .brand-copy,.footer-brand>span:last-child{font:700 14px var(--display);letter-spacing:-.025em}
        .brand-copy small,.footer-brand small{display:block;margin-top:4px;color:var(--muted);font:400 11px var(--body)}
        .primary-navigation{display:flex;gap:clamp(18px,3vw,42px);align-items:center}
        .primary-navigation>a:not(.nav-cta){color:#d3d1c9;font-size:13px}
        .nav-cta{display:flex;min-height:46px;padding:0 19px;gap:17px;align-items:center;border-radius:9px;background:var(--accent);color:var(--ink);font-size:13px;font-weight:700}
        .menu-toggle{display:none}
        .hero{position:relative;display:grid;width:min(1320px,calc(100% - 96px));min-height:690px;margin:0 auto;padding:108px 0 96px;grid-template-columns:1.05fr .95fr;align-items:center;gap:6%}
        .hero-copy{position:relative;z-index:1;padding-bottom:36px}
        .eyebrow{display:flex;margin:0;gap:10px;align-items:center;color:var(--muted);font:10px var(--mono);letter-spacing:.11em;text-transform:uppercase}
        .status-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 15px rgba(201,243,106,.55)}
        .eyebrow-divider{color:var(--accent)}
        .hero h1,.section-heading h2,.about-copy h2,.contact-intro h2{margin:29px 0 0;font:600 clamp(58px,7.3vw,104px)/.98 var(--display);letter-spacing:-.085em}
        .hero h1{font-size:clamp(54px,6.2vw,86px)}
        .hero h1 span,.section-heading h2 span,.about-copy h2 span,.contact-intro h2 span{color:var(--accent)}
        .hero-intro{max-width:470px;margin:25px 0 0;color:#b7b6ac;font-size:17px;line-height:1.7}
        .hero-actions{display:flex;margin-top:31px;gap:12px;flex-wrap:wrap}
        .button{display:inline-flex;min-height:52px;padding:0 19px;gap:20px;align-items:center;justify-content:center;border:1px solid transparent;border-radius:7px;font-size:13px;font-weight:700}
        .button-primary{background:var(--accent);color:var(--ink)}
        .button-secondary{border-color:var(--line);color:var(--paper)}
        .button span{font-size:17px}
        .service-ribbon{display:flex;margin:39px 0 0;padding:0;list-style:none}
        .service-ribbon li{padding:0 17px;border-right:1px solid var(--line);color:var(--muted);font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase}
        .service-ribbon li:first-child{padding-left:0}
        .service-ribbon li:last-child{border:0}
        .hero-art{position:relative;display:grid;min-height:440px;overflow:hidden;place-items:center;border:1px solid rgba(243,240,233,.12);border-radius:13px;background:radial-gradient(ellipse at 70% 40%,rgba(201,243,106,.12),transparent 35%),linear-gradient(135deg,#24251e,#151611 70%)}
        .hero-art:before,.hero-art:after{position:absolute;width:410px;height:410px;border:1px solid rgba(243,240,233,.08);border-radius:50%;content:""}
        .hero-art:after{width:310px;height:310px}
        .hero-art-top,.hero-art-bottom{position:absolute;right:24px;left:24px;display:flex;justify-content:space-between;color:#a1a195;font:9px var(--mono);letter-spacing:.12em}
        .hero-art-top{top:22px}
        .hero-art-bottom{bottom:21px}
        .hero-monogram{position:relative;z-index:1;margin:-20px 0 0 -7px;font:800 clamp(116px,17vw,220px)/1 var(--display);letter-spacing:-.13em}
        .hero-monogram span{color:var(--accent)}
        .art-orbit{position:absolute;z-index:1;width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:0 0 24px rgba(201,243,106,.6)}
        .orbit-one{top:25%;right:25%}
        .orbit-two{bottom:27%;left:21%;width:8px;height:8px;background:#e7a4ff}
        .art-card{position:absolute;z-index:2;display:flex;width:170px;height:120px;padding:13px;flex-direction:column;justify-content:space-between;border:1px solid rgba(243,240,233,.22);border-radius:8px;background:rgba(31,32,27,.92);box-shadow:0 14px 50px #090a08aa}
        .art-card-back{top:26%;right:8%;transform:rotate(9deg)}
        .art-card-front{bottom:18%;left:8%;transform:rotate(-8deg);background:var(--paper);color:var(--ink)}
        .art-card-label{color:var(--accent);font:8px var(--mono);letter-spacing:.08em}
        .art-card-lines{width:100%;height:3px;border-radius:3px;background:rgba(243,240,233,.48)}
        .art-card-lines.short{width:56%}
        .mini-window{display:flex;gap:4px}
        .mini-window i{width:5px;height:5px;border-radius:50%;background:#b6b4a9}
        .art-spark{align-self:flex-end;color:#738c37;font-size:30px}
        .art-card-caption{font:800 13px/1.1 var(--display);letter-spacing:-.05em}
        .scroll-cue{position:absolute;right:0;bottom:34px;display:flex;gap:15px;align-items:center;color:var(--muted);font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase}
        .scroll-cue span{color:var(--accent);font-size:20px}
        .section{width:min(1320px,calc(100% - 96px));margin:0 auto;padding:112px 0}
        .section-heading{display:flex;margin-bottom:39px;align-items:flex-end;justify-content:space-between;gap:30px}
        .section-kicker{color:var(--accent)}
        .section-heading h2,.about-copy h2,.contact-intro h2{margin-top:19px;font-size:clamp(46px,6vw,74px);line-height:1.03}
        .section-note{max-width:355px;margin:0 0 8px;color:var(--muted);font-size:14px;line-height:1.7}
        .project-filters{display:flex;margin-bottom:26px;gap:8px;overflow-x:auto;padding:0 0 7px;scrollbar-width:thin}
        .filter-chip{display:flex;min-height:36px;padding:0 12px;flex:0 0 auto;gap:8px;align-items:center;border:1px solid var(--line);border-radius:4px;background:transparent;color:#c5c3b9;font-size:11px}
        .filter-chip span{color:var(--muted);font:9px var(--mono)}
        .filter-chip:hover,.filter-chip.is-active{border-color:var(--accent);background:var(--accent);color:var(--ink)}
        .project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px 20px}
        .project-card[hidden]{display:none}
        .project-art{position:relative;display:flex;min-height:245px;overflow:hidden;align-items:center;justify-content:center;border:1px solid rgba(243,240,233,.1);border-radius:8px;background:#24231f;transition:transform .25s,border-color .25s}
        .project-art:hover{transform:translateY(-4px);border-color:rgba(201,243,106,.55)}
        .project-index,.project-art-label{position:absolute;z-index:2;top:14px;color:rgba(243,240,233,.78);font:9px var(--mono);letter-spacing:.09em;text-transform:uppercase}
        .project-index{left:14px}
        .project-art-label{right:14px}
        .project-art-window{position:relative;display:flex;width:76%;min-height:144px;overflow:hidden;flex-direction:column;border:1px solid rgba(255,255,255,.28);border-radius:6px;background:rgba(255,255,255,.91);box-shadow:0 16px 35px #0005;color:#25261f;transform:rotate(-2deg);transition:transform .3s}
        .project-art:hover .project-art-window{transform:rotate(0) scale(1.03)}
        .window-top{display:flex;height:25px;padding:0 8px;gap:4px;align-items:center;border-bottom:1px solid #deded9;background:#fff}
        .window-top i{width:5px;height:5px;border-radius:50%;background:#b6b6ad}
        .window-top b{overflow:hidden;margin-left:auto;color:#77786f;font:6px var(--mono);text-overflow:ellipsis;white-space:nowrap}
        .window-content{position:relative;display:flex;min-height:118px;padding:14px;flex-direction:column;justify-content:center}
        .window-heading{position:relative;z-index:1;max-width:74%;font:800 16px/1.05 var(--display);letter-spacing:-.06em}
        .window-line{position:relative;z-index:1;width:45%;height:3px;margin-top:9px;border-radius:4px;background:#bfc0b6}
        .window-line-short{width:29%;margin-top:5px}
        .window-shape{position:absolute;right:12px;bottom:12px;display:grid;width:50px;height:50px;place-items:center;border-radius:50%;background:var(--accent);font:800 18px var(--display)}
        .project-art-arrow{position:absolute;right:14px;bottom:12px;color:var(--paper);font-size:17px}
        .project-art--fashion{background:radial-gradient(ellipse at 70% 40%,#d89c67,transparent 30%),linear-gradient(135deg,#49352a,#9b6450 48%,#251f1e)}
        .project-art--marketing{background:linear-gradient(135deg,#1d3452,#366579 55%,#a9d2c2)}
        .project-art--beauty{background:radial-gradient(ellipse at 75% 30%,#f5ccd5,transparent 27%),linear-gradient(135deg,#624750,#dca2ae 55%,#f1cdd0)}
        .project-art--directory{background:linear-gradient(145deg,#243e39,#51715d 50%,#c1bd8e)}
        .project-art--trades{background:linear-gradient(145deg,#34352f,#a26d37 55%,#d3ab64)}
        .project-art--deli{background:radial-gradient(ellipse at 30% 38%,#e8c994,transparent 27%),linear-gradient(135deg,#4d3025,#9d5a39 55%,#ddaa70)}
        .project-art--sky{background:linear-gradient(155deg,#78b5c6,#458090 47%,#283747)}
        .project-art--learning{background:linear-gradient(135deg,#372c5c,#7261a1 54%,#c3a5d4)}
        .project-art--college{background:linear-gradient(145deg,#2c4137,#758846 56%,#d0bd75)}
        .project-art--wellness{background:linear-gradient(145deg,#36453e,#82917b 50%,#d4cda9)}
        .project-art--tech{background:linear-gradient(145deg,#1e3448,#42667d 55%,#9db5bd)}
        .project-art--repair{background:linear-gradient(145deg,#202c32,#55736e 55%,#bad3c1)}
        .project-art--swatches{background:linear-gradient(135deg,#4d3151,#b37b9a 55%,#e7c2ce)}
        .project-art--corporate{background:linear-gradient(145deg,#1d333e,#417280 55%,#abc6b1)}
        .project-art--stay{background:linear-gradient(145deg,#39423b,#777e62 55%,#d1b386)}
        .project-meta{display:flex;margin-top:16px;align-items:flex-start;justify-content:space-between}
        .project-category{margin:0 0 5px;color:var(--accent);font:9px var(--mono);letter-spacing:.1em;text-transform:uppercase}
        .project-meta h3{margin:0;font:600 17px var(--display);letter-spacing:-.04em}
        .project-link-mark{color:var(--muted);font-size:18px}
        .project-description{margin:7px 0 0;color:var(--muted);font-size:12px;line-height:1.6}
        .about-section{display:grid;padding-top:122px;padding-bottom:122px;grid-template-columns:.9fr 1.1fr;gap:9%;border-top:1px solid var(--line)}
        .about-copy>p:not(.eyebrow){max-width:490px;margin:21px 0 0;color:var(--muted);font-size:14px;line-height:1.8}
        .text-link,.whatsapp-link{display:inline-flex;margin-top:27px;padding-bottom:7px;gap:15px;align-items:center;border-bottom:1px solid var(--accent);font-size:13px}
        .text-link span,.whatsapp-link span{color:var(--accent)}
        .service-cards{display:flex;flex-direction:column;justify-content:center}
        .service-card{display:grid;min-height:125px;padding:23px 0;grid-template-columns:36px 1fr 30px;gap:15px;align-items:start;border-bottom:1px solid var(--line)}
        .service-card:first-child{border-top:1px solid var(--line)}
        .service-number,.stack-index{color:var(--accent);font:10px var(--mono)}
        .service-card h3,.stack-card h3{margin:0;font:600 17px var(--display);letter-spacing:-.03em}
        .service-card p{max-width:430px;margin:8px 0 0;color:var(--muted);font-size:12px;line-height:1.7}
        .service-symbol{justify-self:end;color:var(--accent);font-size:17px}
        .stack-section{padding-top:0}
        .stack-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
        .stack-card{min-height:175px;padding:20px 18px 22px;border-right:1px solid var(--line)}
        .stack-card:first-child{padding-left:0}
        .stack-card:last-child{padding-right:0;border-right:0}
        .stack-index{display:block;margin-bottom:27px;font-size:9px}
        .stack-card h3{font-size:14px}
        .stack-card p{margin:10px 0 0;color:var(--muted);font-size:11px;line-height:1.8}
        .contact-section{display:grid;padding:76px;grid-template-columns:1fr .85fr;gap:10%;border:1px solid var(--line);border-radius:12px;background:radial-gradient(ellipse at 5% 5%,rgba(201,243,106,.08),transparent 38%),#151611}
        .contact-intro>p:not(.eyebrow){max-width:420px;margin:20px 0 0;color:var(--muted);font-size:14px;line-height:1.8}
        .contact-details{display:flex;margin-top:29px;flex-direction:column;gap:15px}
        .contact-details>a,.contact-details>p{display:flex;margin:0;gap:12px;align-items:center;font-size:12px}
        .contact-details>a:hover{color:var(--accent)}
        .contact-icon{display:grid;width:34px;height:34px;flex:0 0 auto;place-items:center;border:1px solid var(--line);border-radius:50%;color:var(--accent)}
        .contact-details small{display:block;margin-bottom:3px;color:var(--muted);font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}
        .contact-form{display:flex;padding:25px;flex-direction:column;gap:15px;border:1px solid var(--line);border-radius:8px;background:#1b1c17}
        .form-eyebrow{margin:0 0 3px;color:var(--accent);font:10px var(--mono)}
        .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
        .contact-form label{display:flex;min-width:0;flex-direction:column;gap:7px;color:#d5d3c9;font-size:11px}
        .contact-form input,.contact-form select,.contact-form textarea{width:100%;padding:12px;border:1px solid rgba(243,240,233,.15);border-radius:4px;background:#13140f;color:var(--paper);font:12px var(--body)}
        .contact-form textarea{resize:vertical}
        .form-submit{width:100%;cursor:pointer}
        .form-note{margin:-5px 0 0;color:var(--muted);font-size:10px;line-height:1.5}
        .form-note-success{color:var(--accent)}
        .form-note-error,.field-validation-error,.validation-summary-errors{color:#ff9b91}
        .field-validation-error{font-size:10px}
        .site-footer{display:grid;width:min(1320px,calc(100% - 96px));min-height:150px;margin:0 auto;padding:31px 0;grid-template-columns:1.2fr 1fr 1.3fr auto;gap:25px;align-items:center;border-top:1px solid var(--line)}
        .site-footer>p{margin:0;color:var(--muted);font-size:11px;line-height:1.7}
        .footer-links{display:flex;gap:18px;color:#cfcdc3;font-size:11px}
        .footer-copy{color:var(--muted);font:9px var(--mono);white-space:nowrap}
        @@media(max-width:1000px){.hero{width:calc(100% - 64px);grid-template-columns:1fr 1fr;gap:4%}.hero h1{font-size:clamp(54px,6.2vw,72px)}.hero-art{min-height:375px}.section,.site-footer{width:calc(100% - 64px)}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.about-section{gap:5%}.stack-grid{grid-template-columns:repeat(3,1fr)}.stack-card:nth-child(3){border-right:0}.stack-card:nth-child(n+4){border-top:1px solid var(--line)}.contact-section{padding:44px;gap:6%}.site-footer{grid-template-columns:1fr 1fr}}
        @@media(max-width:700px){html{scroll-padding-top:84px}.site-header{top:9px;width:calc(100% - 24px);min-height:63px;margin-top:9px;padding:7px 9px}.brand-mark{width:40px;height:40px;border-radius:11px}.brand-copy{font-size:12px}.brand-copy small{font-size:10px}.menu-toggle{display:flex;width:42px;height:42px;padding:12px 10px;flex-direction:column;align-items:center;justify-content:center;gap:6px;border:1px solid var(--line);border-radius:8px;background:transparent}.menu-toggle span{width:17px;height:1px;background:var(--paper)}.primary-navigation{position:absolute;top:calc(100% + 8px);right:0;left:0;display:none;padding:15px;flex-direction:column;align-items:stretch;gap:0;border:1px solid var(--line);border-radius:10px;background:#171814}.primary-navigation.is-open{display:flex}.primary-navigation>a:not(.nav-cta){padding:13px 4px;border-bottom:1px solid var(--line)}.primary-navigation .nav-cta{justify-content:space-between;margin-top:12px}.hero{width:calc(100% - 40px);min-height:0;padding:86px 0 82px;grid-template-columns:1fr;gap:35px}.hero h1{margin-top:24px;font-size:clamp(57px,14vw,82px)}.hero-intro{font-size:15px}.hero-art{min-height:330px}.hero-monogram{font-size:155px}.art-card{width:145px;height:105px}.scroll-cue{bottom:26px}.section,.site-footer{width:calc(100% - 40px)}.section{padding:82px 0}.section-heading{margin-bottom:26px;flex-direction:column;align-items:flex-start;gap:13px}.section-heading h2,.about-copy h2{font-size:clamp(43px,11vw,63px)}.section-note{font-size:13px}.project-grid{grid-template-columns:1fr;gap:27px}.project-art{min-height:250px}.about-section{padding-top:82px;padding-bottom:82px;grid-template-columns:1fr;gap:37px}.service-card{min-height:112px;grid-template-columns:30px 1fr 25px}.stack-section{padding-top:0}.stack-grid{grid-template-columns:repeat(2,1fr)}.stack-card,.stack-card:first-child{min-height:145px;padding:16px 12px;border-top:1px solid var(--line)}.stack-card:nth-child(odd){padding-left:0;border-right:1px solid var(--line)}.stack-card:nth-child(even){padding-right:0;border-right:0}.stack-card:nth-child(3){border-right:1px solid var(--line)}.stack-card:last-child{border-right:0}.stack-index{margin-bottom:17px}.contact-section{width:calc(100% - 24px);padding:30px 20px;grid-template-columns:1fr;gap:32px}.contact-intro h2{font-size:clamp(43px,11vw,61px)}.contact-form{padding:18px}.site-footer{padding:27px 0;grid-template-columns:1fr 1fr;gap:22px 12px}.site-footer>p{font-size:10px}.footer-links{gap:12px;flex-wrap:wrap}.footer-copy{justify-self:end}}
        @@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}}
    </style>
</head>
<body>
    <header class="site-header">
        <a class="header-brand" href="#top" aria-label="Sonwabile Langa, back to top">
            <span class="brand-mark">SL<span>.</span></span>
            <span class="brand-copy">Sonwabile Langa<small>Independent developer</small></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation"><span></span><span></span></button>
        <nav class="primary-navigation" id="primary-navigation" aria-label="Main navigation">
            <a href="#work">Work</a>
            <a href="#about">About</a>
            <a href="#stack">Stack</a>
            <a href="#contact">Contact</a>
            <a class="nav-cta" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
        </nav>
    </header>
    <main id="main-content">
        @RenderBody()
    </main>
    <script>
        const filterButtons = document.querySelectorAll(".filter-chip");
        const projectCards = document.querySelectorAll(".project-card");

        for (const button of filterButtons) {
            button.addEventListener("click", () => {
                const filter = button.dataset.filter;

                for (const filterButton of filterButtons) {
                    const isActive = filterButton === button;
                    filterButton.classList.toggle("is-active", isActive);
                    filterButton.setAttribute("aria-pressed", String(isActive));
                }

                for (const card of projectCards) {
                    card.hidden = filter !== "all" && card.dataset.category !== filter;
                }
            });
        }

        const menuToggle = document.querySelector(".menu-toggle");
        const navigation = document.querySelector(".primary-navigation");

        menuToggle?.addEventListener("click", () => {
            const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
            menuToggle.setAttribute("aria-expanded", String(!isExpanded));
            menuToggle.setAttribute("aria-label", isExpanded ? "Open navigation" : "Close navigation");
            navigation?.classList.toggle("is-open", !isExpanded);
        });

        navigation?.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                menuToggle?.setAttribute("aria-expanded", "false");
                menuToggle?.setAttribute("aria-label", "Open navigation");
                navigation.classList.remove("is-open");
            });
        });

    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
